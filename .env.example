# Hackathon local defaults (no real GCP required when SKIP_AUTH=1)
SKIP_AUTH=1
VALIDATION_PORT=8010
MCLANE_PORT=8011
EXTRACTION_PORT=8012
REVIEW_PORT=8014

# review_service (line-item review UI)
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# REVIEW_DEV_AUTH=1          # email-only sign-in for local testing; never in prod
# LOCK_TTL_SECONDS=45
# COOKIE_SECURE=1            # when served over HTTPS

# Mailbox poller + bootstrap/sync_pulls_to_postgres.py
# DATABASE_URL=postgresql://user:pass@host:5432/mydb
# PUBLIC_VIEW_TOKEN=replace-with-a-long-random-token

# extraction_service /extract/structured
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# PRISM observability for OpenAI and Nicrron calls
# Traces include document prompt/output content; use a project appropriate for that data.
# PRISMTRACE_HOST=https://prism.blockconvey.com
# PRISMTRACE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# PRISMTRACE_API_KEY=pt-sk-...

# For mint_sa_token.py / production-like auth:
# BACKEND_URL=https://your-backend.example
# BACKEND_TOKEN_AUDIENCE=https://your-backend.example
# BACKEND_SA_FILE=/path/to/sa-key.json
# BACKEND_IMPERSONATE_SERVICE_ACCOUNT=pipeline@project.iam.gserviceaccount.com
# LOCAL_SA_TOKEN=<output of bootstrap/mint_sa_token.py>
