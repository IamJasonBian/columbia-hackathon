# Hackathon local defaults (no real GCP required when SKIP_AUTH=1)
SKIP_AUTH=1
VALIDATION_PORT=8010
REVIEW_PORT=8014

# services/review (doc-line review UI)
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
# REVIEW_DEV_AUTH=1          # email-only sign-in for local testing; never in prod
# LOCK_TTL_SECONDS=45
# COOKIE_SECURE=1            # when served over HTTPS

# Mailbox poller + pipeline worker
# DATABASE_URL=postgresql://user:pass@host:5432/mydb

# Nicrron classification / compliance (pipeline worker)
# NICRRON_API_KEY=sk-af-...
# NICRRON_MODEL=nicrron/fastest

# PRISM observability for Nicrron calls
# Traces include document prompt/output content; use a project appropriate for that data.
# PRISMTRACE_HOST=https://prism.blockconvey.com
# PRISMTRACE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# PRISMTRACE_API_KEY=pt-sk-...

# Static bearer token for services/validation routes when SKIP_AUTH=0
# LOCAL_SA_TOKEN=replace-with-a-long-random-token
