# Line-item review app (services/review + frontend) for Cloud Run.
# Build: gcloud builds submit --config services/review/deploy/cloudbuild.yaml

FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY services/review/deploy/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY services/__init__.py ./services/__init__.py
COPY services/review/ ./services/review/
COPY --from=web /web/dist ./frontend/dist
USER nobody
CMD ["sh", "-c", "exec uvicorn services.review.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*'"]
