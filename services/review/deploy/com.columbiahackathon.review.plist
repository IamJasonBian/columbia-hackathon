<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps services.review running on :8014 (restarts on crash/login). Install:
     cp this file to ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) <that path>
     Remove: launchctl bootout gui/$(id -u)/com.columbiahackathon.review -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.columbiahackathon.review</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jasonzb/columbia hackathon/.venv/bin/python</string>
    <string>-m</string>
    <string>services.review.main</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jasonzb/columbia hackathon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>/Users/jasonzb/columbia hackathon</string>
    <key>REVIEW_DEV_AUTH</key><string>1</string>
    <key>COOKIE_SECURE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/jasonzb/columbia hackathon/app_storage/review_service.log</string>
  <key>StandardErrorPath</key><string>/Users/jasonzb/columbia hackathon/app_storage/review_service.log</string>
</dict>
</plist>
